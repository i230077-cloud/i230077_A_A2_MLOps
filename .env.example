# LLM API Keys (configure at least one provider)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional: Default LLM Provider and Model
# Supported providers: gemini (default), openai, anthropic, groq
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Optional: GitHub Personal Access Token (for higher API rate limits on public repos if needed)
GITHUB_TOKEN=
